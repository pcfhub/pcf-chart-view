  <data name="ChartView_Name" xml:space="preserve">
    <value>Diagrammansicht</value>
  </data>
  <data name="ChartView_Desc" xml:space="preserve">
    <value>Eine Dataverse-Ansicht als Balken-, Säulen-, Kreis-, Ring- oder Liniendiagramm — gruppiert nach einer Spalte, auf dem Server aggregiert.</value>
  </data>
  <data name="Records_DataSet_Name" xml:space="preserve">
    <value>Datensätze</value>
  </data>
  <data name="CategoryField_Name" xml:space="preserve">
    <value>Gruppieren nach</value>
  </data>
  <data name="CategoryField_Desc" xml:space="preserve">
    <value>Die Spalte, nach der gruppiert wird: ein Balken, Segment oder Punkt pro Wert. Eine Auswahl-, Ja/Nein-, Nachschlage-, Text- oder Datumsspalte.</value>
  </data>
  <data name="ValueField_Name" xml:space="preserve">
    <value>Wert</value>
  </data>
  <data name="ValueField_Desc" xml:space="preserve">
    <value>Die Zahlenspalte, die pro Gruppe summiert, gemittelt oder verglichen wird. Leer lassen, um Datensätze zu zählen.</value>
  </data>
  <data name="ChartType_Name" xml:space="preserve">
