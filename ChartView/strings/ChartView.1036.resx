  <data name="ChartView_Name" xml:space="preserve">
    <value>Vue graphique</value>
  </data>
  <data name="ChartView_Desc" xml:space="preserve">
    <value>Une vue Dataverse sous forme de graphique à barres, colonnes, secteurs, anneau ou courbe — groupée par une colonne, agrégée côté serveur.</value>
  </data>
  <data name="Records_DataSet_Name" xml:space="preserve">
    <value>Enregistrements</value>
  </data>
