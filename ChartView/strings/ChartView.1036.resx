  </data>
  <data name="ValueField_Name" xml:space="preserve">
    <value>Valeur</value>
  </data>
  <data name="ValueField_Desc" xml:space="preserve">
    <value>La colonne numérique additionnée, moyennée ou comparée par groupe. Laisser vide pour compter les enregistrements.</value>
