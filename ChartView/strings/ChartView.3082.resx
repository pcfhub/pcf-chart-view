  <data name="ChartView_Name" xml:space="preserve">
    <value>Vista de gráfico</value>
  </data>
  <data name="ChartView_Desc" xml:space="preserve">
    <value>Una vista de Dataverse como gráfico de barras, columnas, circular, de anillo o de líneas: agrupada por una columna y agregada en el servidor.</value>
  </data>
  <data name="Records_DataSet_Name" xml:space="preserve">
    <value>Registros</value>
  </data>
  <data name="CategoryField_Name" xml:space="preserve">
    <value>Agrupar por</value>
  </data>
  <data name="CategoryField_Desc" xml:space="preserve">
    <value>La columna por la que se agrupan los registros: una barra, un sector o un punto por valor. Una columna de elección, Sí/No, búsqueda, texto o fecha.</value>
  </data>
  <data name="ValueField_Name" xml:space="preserve">
    <value>Valor</value>
  </data>
  <data name="ValueField_Desc" xml:space="preserve">
    <value>La columna numérica que se suma, promedia o compara por grupo. Déjela vacía para contar registros.</value>
  </data>
  <data name="ChartType_Name" xml:space="preserve">
