    <value>最小</value>
  </data>
  <data name="Aggregate_Max" xml:space="preserve">
    <value>最大</value>
  </data>
  <data name="DateGrouping_Name" xml:space="preserve">
    <value>日付のグループ化</value>
  </data>
  <data name="DateGrouping_Desc" xml:space="preserve">
    <value>日付列でグループ化するときの区切り。他の列の種類では無視されます。</value>
  </data>
  <data name="DateGrouping_Day" xml:space="preserve">
