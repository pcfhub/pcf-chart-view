  <data name="ChartView_Name" xml:space="preserve">
    <value>グラフ ビュー</value>
  </data>
  <data name="ChartView_Desc" xml:space="preserve">
    <value>Dataverse のビューを棒・縦棒・円・ドーナツ・折れ線グラフとして表示します。列でグループ化し、サーバー側で集計します。</value>
  </data>
  <data name="Records_DataSet_Name" xml:space="preserve">
    <value>レコード</value>
  </data>
  <data name="CategoryField_Name" xml:space="preserve">
    <value>グループ化</value>
  </data>
  <data name="CategoryField_Desc" xml:space="preserve">
    <value>レコードをグループ化する列。値ごとに 1 本の棒・1 つの扇形・1 点になります。選択肢、はい/いいえ、参照、テキスト、日付の列。</value>
  </data>
  <data name="ValueField_Name" xml:space="preserve">
    <value>値</value>
  </data>
  <data name="ValueField_Desc" xml:space="preserve">
    <value>グループごとに合計・平均・比較する数値列。空にするとレコード数を数えます。</value>
  </data>
  <data name="ChartType_Name" xml:space="preserve">
    <value>グラフの種類</value>
  </data>
  <data name="ChartType_Desc" xml:space="preserve">
    <value>縦棒、横棒、円、ドーナツ、折れ線。</value>
  </data>
  <data name="ChartType_Column" xml:space="preserve">
    <value>縦棒</value>
  </data>
  <data name="ChartType_Bar" xml:space="preserve">
    <value>横棒</value>
  </data>
  <data name="ChartType_Pie" xml:space="preserve">
    <value>円</value>
  </data>
  <data name="ChartType_Donut" xml:space="preserve">
    <value>ドーナツ</value>
  </data>
  <data name="ChartType_Line" xml:space="preserve">
    <value>折れ線</value>
  </data>
  <data name="Aggregate_Name" xml:space="preserve">
    <value>集計</value>
  </data>
  <data name="Aggregate_Desc" xml:space="preserve">
    <value>各グループに表示する値。レコード数、または値列の合計・平均・最小・最大。</value>
  </data>
  <data name="Aggregate_Count" xml:space="preserve">
    <value>件数</value>
  </data>
  <data name="Aggregate_Sum" xml:space="preserve">
    <value>合計</value>
  </data>
  <data name="Aggregate_Avg" xml:space="preserve">
