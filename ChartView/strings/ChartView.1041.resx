  </data>
  <data name="DateGrouping_Year" xml:space="preserve">
    <value>年</value>
  </data>
  <data name="TopN_Name" xml:space="preserve">
    <value>上位グループ数</value>
  </data>
  <data name="TopN_Desc" xml:space="preserve">
    <value>上位のグループをこの数だけ残し、残りは「その他」にまとめます。空ならすべて表示します。</value>
  </data>
  <data name="SortBy_Name" xml:space="preserve">
    <value>並べ替え</value>
  </data>
  <data name="SortBy_Desc" xml:space="preserve">
